{
  "name": "kspdb-localization",
  "version": "1.0.0",
  "description": "Karnataka State Power Distribution Board Fault Ingestion and Localization System",
  "main": "dist/backend/index.js",
  "scripts": {
    "init-db": "ts-node -P tsconfig.backend.json src/backend/seed.ts",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node dist/backend/index.js",
    "dev:backend": "ts-node -P tsconfig.backend.json src/backend/index.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "jest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.28.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
